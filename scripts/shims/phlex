# Runs the real phlex with jemalloc preloaded. Installed on PATH ahead of
# $CONDA_PREFIX/bin by activate.sh; see the comment there for why the
# preload is scoped to phlex instead of exported for the whole environment.
exec env LD_PRELOAD="$CONDA_PREFIX/lib/libjemalloc.so.2${LD_PRELOAD:+:$LD_PRELOAD}" \
    "$CONDA_PREFIX/bin/phlex" "$@"
